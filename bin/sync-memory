#!/usr/bin/env python3
"""
sync-memory — runs on agent session-end hook.
Promotes short-term agent memory into the shared ~/memory/ vault.
Safe: never overwrites vault, only updates the agent's state file.

Configuration (set as environment variables or edit defaults below):
  AGENT_NAME          — name of the agent (default: "agent")
  AGENT_MEMORY_FILE   — path to agent's own memory file (default: ~/.agent/memory.md)
  VAULT_DIR           — path to the shared vault (default: ~/memory)
"""

import json
import sys
import hashlib
import os
from pathlib import Path
from datetime import datetime, timezone

# --- Configuration via env vars ---
AGENT_NAME = os.environ.get("AGENT_NAME", "agent")
AGENT_MEMORY = Path(
    os.environ.get("AGENT_MEMORY_FILE", str(Path.home() / f".{AGENT_NAME}" / "memory.md"))
).expanduser()
VAULT = Path(os.environ.get("VAULT_DIR", str(Path.home() / "memory"))).expanduser()

AGENT_STATE = VAULT / "state" / "agents" / f"{AGENT_NAME}.md"
SYNC_HASH = AGENT_MEMORY.parent / f".{AGENT_NAME}_sync_hash"
LOG = VAULT / "log" / f"{datetime.now().strftime('%Y-%m')}.md"


def ts():
    return datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M")


def md5(content):
    return hashlib.md5(content.encode()).hexdigest()


def append_log(msg):
    if LOG.exists():
        with open(LOG, "a") as f:
            f.write(f"{msg}\n")


def main():
    if not AGENT_MEMORY.exists():
        print(json.dumps({"ok": True, "synced": False, "reason": "no memory file found"}))
        sys.exit(0)

    content = AGENT_MEMORY.read_text().strip()
    new_hash = md5(content)
    old_hash = SYNC_HASH.read_text().strip() if SYNC_HASH.exists() else ""

    if new_hash == old_hash:
        print(json.dumps({"ok": True, "synced": False, "reason": "unchanged"}))
        sys.exit(0)

    # Memory changed — promote to vault
    AGENT_STATE.parent.mkdir(parents=True, exist_ok=True)
    AGENT_STATE.write_text(
        f"# {AGENT_NAME.capitalize()} Agent State\n_last_synced: {ts()}_\n\n{content}\n"
    )
    SYNC_HASH.write_text(new_hash)
    append_log(f"[{ts()}][{AGENT_NAME}] memory synced to vault (state/agents/{AGENT_NAME}.md)")

    print(json.dumps({"ok": True, "synced": True, "agent": AGENT_NAME}))


if __name__ == "__main__":
    main()
